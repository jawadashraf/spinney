                        <Parameter Name="Data" Type="Body" Value="{&#34;Subject&#34;: &#34;{{.Subject}}&#34;,&#34;Status&#34;: &#34;Completed&#34;,&#34;Description&#34;: &#34;{{.Description}}&#34;,&#34;WhoId&#34;: &#34;{{if or (eq .ContactSyncType &#34;leads&#34;) (eq .ContactSyncType &#34;contacts&#34;)}}{{.ContactId}}{{end}}&#34;,&#34;WhatId&#34;: &#34;{{if eq .ContactSyncType &#34;accounts&#34;}}{{.ContactId}}{{end}}&#34;,&#34;ActivityDate&#34;:&#34;{{ TimeFormat .StartTimeUnix &#34;yyyy-MM-dd&#34; &#34;1&#34;}}&#34;,&#34;TaskSubtype&#34;: &#34;Call&#34;,&#34;Priority&#34;: &#34;Normal&#34;{{if .CrmId}},&#34;OwnerId&#34;: &#34;{{.CrmId}}&#34;{{end}}}"></Parameter>
                    </Parameters>
                    <Outputs>
