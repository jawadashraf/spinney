                    </Outputs>
                </Request>
                <Request Name="CallJournalUpdate" Method="PATCH" URLFormat="{{.instance_url}}{{.APIVersion}}/sobjects/Task/{{.CrmActId}}" ResponseType="application/json">
                    <Parameters>
                        <Parameter Name="Data" Type="Body" Value="{&#34;Description&#34;: &#34;{{.Description}}&#34;}"></Parameter>
                    </Parameters>
                    <Outputs></Outputs>
                </Request>
            </Requests>
